flowchart TB
  Q0(["You have a new rule or lesson"]):::you
  Q1{"Will it apply to EVERY<br/>dashboard from now on?"}:::n
  Q2{"Can a script check it<br/>with no judgement?"}:::n
  Q3{"Is it a PROCEDURE<br/>(a sequence of steps)?"}:::n
  Q4{"Is it true only for<br/>THIS dashboard?"}:::n
  A1["HOOK / SCRIPT<br/>scripts/ (ask a maintainer)"]:::r
  A2["SKILL<br/>.github/skills/&lt;name&gt;/SKILL.md"]:::aa
  A3["STEERING<br/>.github/copilot-instructions.md<br/>(then align copilot-instructions.md)"]:::aa
  A4["SPEC<br/>specs/&lt;page&gt;.md"]:::g
  Q0 --> Q2
  Q2 -- "yes" --> A1
  Q2 -- "no" --> Q3
  Q3 -- "yes" --> A2
  Q3 -- "no" --> Q1
  Q1 -- "yes" --> A3
  Q1 -- "no" --> Q4
  Q4 -- "yes" --> A4
  Q4 -- "not sure" --> A4
